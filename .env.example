# Server
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vids_clone

# JWT
JWT_SECRET=change-me-to-a-secure-random-string
JWT_EXPIRE_MINUTES=60

# Admin credentials
ADMIN_USERNAME=admin
# Generate with: python -c "from app.auth import hash_password; print(hash_password('your-password'))"
ADMIN_PASSWORD_HASH=

# Hiker API
HIKER_API_TOKEN=
HIKER_BASE_URL=https://api.hikerapi.com

# Rate limiting
RATE_LIMIT_PER_MINUTE=60

# Prometheus
PROMETHEUS_PORT=8001