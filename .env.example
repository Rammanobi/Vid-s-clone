# Server
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vids_clone

# Database pool
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=20
DB_POOL_MAX_QUERIES=50000
DB_POOL_MAX_LIFETIME=3600

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET=change-me-to-a-secure-random-string
JWT_EXPIRE_MINUTES=60

# Admin credentials
ADMIN_USERNAME=admin
# Generate with: python -c "from app.auth import hash_password; print(hash_password('your-password'))"
ADMIN_PASSWORD_HASH=

# Hiker API
HIKER_API_TOKEN=
HIKER_BASE_URL=https://api.hikerapi.com

# Rate limiting
RATE_LIMIT_PER_MINUTE=60

# LLM / AI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_MAX_RETRIES=3
LLM_TIMEOUT_SEC=30

# Creator intelligence
CREATOR_UPDATE_INTERVAL_HOURS=24

# Prometheus
PROMETHEUS_PORT=8001

# Monitoring (Docker Compose)
PROMETHEUS_EXT_PORT=9090
GRAFANA_PORT=3001
GRAFANA_PASSWORD=admin
NODE_EXPORTER_PORT=9100
CADVISOR_PORT=8080

# Modality thresholds
SPEECH_THRESHOLD=0.1
TEXT_THRESHOLD=0.15
VISUAL_CHANGE_THRESHOLD=0.05
