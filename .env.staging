# .env.staging
ENVIRONMENT=staging
PORT=8000
PROMETHEUS_PORT=8001

# Database — uses Neon pooled connection
DATABASE_URL=postgresql://user:pass@ep-example-123456.us-east-2.aws.neon.tech/vids_clone?sslmode=require&pooled=true

# JWT
JWT_SECRET=
JWT_EXPIRE_MINUTES=120

# Admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# Hiker API
HIKER_API_TOKEN=
HIKER_BASE_URL=https://api.hikerapi.com

# Rate limiting
RATE_LIMIT_PER_MINUTE=120

# Redis
REDIS_URL=redis://redis:6379/0

# LLM
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Updates
CREATOR_UPDATE_INTERVAL_HOURS=12

# Replicas
API_REPLICAS=2
FRONTEND_REPLICAS=2

# Monitoring
PROMETHEUS_RETENTION=15d
GRAFANA_USER=admin
GRAFANA_PASSWORD=
