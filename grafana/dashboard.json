{
  "title": "Vid's Clone Pipeline Dashboard",
  "uid": "vids-clone-pipeline",
  "version": 1,
  "timezone": "browser",
  "panels": [
    {
      "title": "HTTP Requests Rate",
      "type": "graph",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [
        {"expr": "rate(http_requests_total[5m])", "legendFormat": "{{method}} {{endpoint}}"}
      ]
    },
    {
      "title": "HTTP Request Duration (p99)",
      "type": "graph",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "targets": [
        {"expr": "histogram_quantile(0.99, rate(http_request_duration_seconds_bucket[5m]))", "legendFormat": "{{method}} {{endpoint}}"}
      ]
    },
    {
      "title": "DB Query Rate",
      "type": "graph",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "targets": [
        {"expr": "rate(db_queries_total[5m])", "legendFormat": "{{operation}}"}
      ]
    },
    {
      "title": "DB Query Duration (p99)",
      "type": "graph",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "targets": [
        {"expr": "histogram_quantile(0.99, rate(db_query_duration_seconds_bucket[5m]))", "legendFormat": "{{operation}}"}
      ]
    },
    {
      "title": "Auth Attempts",
      "type": "graph",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
      "targets": [
        {"expr": "rate(auth_attempts_total[5m])", "legendFormat": "{{result}}"}
      ]
    },
    {
      "title": "LLM Requests Rate",
      "type": "graph",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
      "targets": [
        {"expr": "rate(llm_requests_total[5m])", "legendFormat": "{{provider}} {{model}}"}
      ]
    },
    {
      "title": "LLM Duration (p99)",
      "type": "graph",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 24},
      "targets": [
        {"expr": "histogram_quantile(0.99, rate(llm_request_duration_seconds_bucket[5m]))", "legendFormat": "{{provider}}"}
      ]
    },
    {
      "title": "Pipeline Runs",
      "type": "graph",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 24},
      "targets": [
        {"expr": "rate(pipeline_runs_total[5m])", "legendFormat": "{{status}}"}
      ]
    },
    {
      "title": "Pipeline Stage Duration",
      "type": "graph",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 32},
      "targets": [
        {"expr": "histogram_quantile(0.99, rate(pipeline_stage_duration_seconds_bucket[5m]))", "legendFormat": "{{stage}} {{status}}"}
      ]
    },
    {
      "title": "Pipeline Stage Errors",
      "type": "graph",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 32},
      "targets": [
        {"expr": "rate(pipeline_stage_errors_total[5m])", "legendFormat": "{{stage}}"}
      ]
    },
    {
      "title": "Agent Invocations",
      "type": "graph",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 40},
      "targets": [
        {"expr": "rate(agent_invocations_total[5m])", "legendFormat": "{{mode}}"}
      ]
    },
    {
      "title": "Agent Duration (p99)",
      "type": "graph",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 40},
      "targets": [
        {"expr": "histogram_quantile(0.99, rate(agent_invocation_duration_seconds_bucket[5m]))", "legendFormat": "{{mode}}"}
      ]
    },
    {
      "title": "Agent Errors Rate",
      "type": "graph",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 48},
      "targets": [
        {"expr": "rate(agent_errors_total[5m])", "legendFormat": "{{mode}}"}
      ]
    },
    {
      "title": "Agent Confidence Distribution",
      "type": "graph",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 48},
      "targets": [
        {"expr": "agent_confidence_bucket", "legendFormat": "{{bucket}}"}
      ]
    },
    {
      "title": "Analytics Pipeline Status",
      "type": "graph",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 56},
      "targets": [
        {"expr": "rate(analytics_runs_total[5m])", "legendFormat": "{{status}}"},
        {"expr": "rate(analytics_errors_total[5m])", "legendFormat": "errors"}
      ]
    },
    {
      "title": "Content Intelligence Pipeline Status",
      "type": "graph",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 56},
      "targets": [
        {"expr": "rate(content_intelligence_runs_total[5m])", "legendFormat": "{{status}}"}
      ]
    },
    {
      "title": "Creator Intelligence Pipeline Status",
      "type": "graph",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 64},
      "targets": [
        {"expr": "rate(creator_intelligence_runs_total[5m])", "legendFormat": "{{status}}"}
      ]
    },
    {
      "title": "Scheduler Health",
      "type": "stat",
      "gridPos": {"h": 8, "w": 6, "x": 12, "y": 64},
      "targets": [
        {"expr": "knowledge_scheduler_running", "legendFormat": "knowledge"},
        {"expr": "pipeline_scheduler_running", "legendFormat": "pipeline"}
      ]
    },
    {
      "title": "Consecutive Failures",
      "type": "graph",
      "gridPos": {"h": 8, "w": 6, "x": 18, "y": 64},
      "targets": [
        {"expr": "knowledge_consecutive_failures", "legendFormat": "knowledge"},
        {"expr": "pipeline_scheduler_consecutive_failures", "legendFormat": "pipeline"}
      ]
    },
    {
      "title": "Pipeline Last Run Duration",
      "type": "stat",
      "gridPos": {"h": 8, "w": 6, "x": 0, "y": 72},
      "targets": [
        {"expr": "pipeline_last_run_duration_seconds", "legendFormat": "{{status}}"}
      ]
    },
    {
      "title": "Reels Processed (All Pipelines)",
      "type": "graph",
      "gridPos": {"h": 8, "w": 12, "x": 6, "y": 72},
      "targets": [
        {"expr": "rate(analytics_reels_processed_total[5m])", "legendFormat": "analytics"},
        {"expr": "rate(content_intelligence_reels_processed_total[5m])", "legendFormat": "content_intel"},
        {"expr": "rate(creator_intelligence_reels_processed_total[5m])", "legendFormat": "creator_intel"}
      ]
    }
  ],
  "rows": [],
  "schemaVersion": 27,
  "style": "dark",
  "tags": ["vids-clone", "pipeline"],
  "templating": {"list": []},
  "annotations": {"list": []},
  "refresh": "30s",
  "time": {"from": "now-6h", "to": "now"},
  "timepicker": {"refresh_intervals": ["5s", "10s", "30s", "1m", "5m", "15m", "30m", "1h", "2h", "1d"]}
}
